{
  "extends": ["@decidim"],
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js"],
        "moduleDirectory": ["app/packs/", "node_modules/"]
      }
    }
  },
  "rules": {
    "import/no-unresolved": ["error", { "ignore": ["^@hotwired/stimulus$", "^html5sortable"] }]
  }
}
