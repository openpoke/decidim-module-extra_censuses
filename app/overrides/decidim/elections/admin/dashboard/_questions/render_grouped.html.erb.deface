<!-- surround "ul" -->
<% if question.grouped? %>
  <% grouped_response_options(question).each do |group, options| %>
    <% if group %>
      <h4 class="font-semibold mt-3 mb-1"><%= translated_attribute(group.title) %></h4>
    <% end %>
    <ul class="mb-2">
      <% options.each_with_index do |option, opt_index| %>
        <li><%= "#{("a".ord + opt_index).chr})" %> <%= translated_attribute(option.body) %></li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <%= render_original %>
<% end %>
