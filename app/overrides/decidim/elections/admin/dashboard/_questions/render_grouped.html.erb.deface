<!-- surround "ul" -->
<% if question.grouped? %>
  <% grouped_response_options(question).each do |group, options| %>
    <% if group %>
      <h4 class="font-semibold mt-3 mb-1"><%= translated_attribute(group.title) %></h4>
    <% end %>
    <ol class="mb-2 grouped-options-list">
      <% options.each do |option| %>
        <li><%= translated_attribute(option.body) %></li>
      <% end %>
    </ol>
  <% end %>
<% else %>
  <%= render_original %>
<% end %>
