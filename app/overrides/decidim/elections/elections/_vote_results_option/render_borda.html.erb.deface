<!-- surround_contents "div:has(> h4[data-option-body])" -->
<% if option.respond_to?(:question) && option.question&.voting_method == "borda" %>
  <h4 data-option-body>
    <%= translated_attribute(option.body) %>
  </h4>
  <div class="flex items-center justify-between gap-2 mb-2">
    <div class="percent-bar">
      <div class="percent-bar-width" style="width: <%= borda_score_width(option.question, option) %>%"></div>
    </div>
    <div class="text-right text-sm leading-tight shrink-0 min-w-[64px]">
      <div><%= t("decidim.extra_censuses.elections.results.borda.points", count: borda_score_for(option.question, option)) %></div>
    </div>
  </div>
<% else %>
  <%= render_original %>
<% end %>
