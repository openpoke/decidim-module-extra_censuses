<!-- surround_contents "div.card-accordion-section" -->
<% if question.grouped? %>
  <div class="mb-4"><%= render_question_description(question) %></div>

  <% grouped_response_options(question).each do |group, options| %>
    <% if group %>
      <h3 class="question-group-title h5 mt-4 mb-2"><%= translated_attribute(group.title) %></h3>
    <% end %>
    <% options.each do |answer| %>
      <h4><%= translated_attribute answer.body %></h4>
    <% end %>
  <% end %>
<% else %>
  <%= render_original %>
<% end %>
