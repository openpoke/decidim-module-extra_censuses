add_to_attributes "div.question__response-options"
attributes "data-controller" => '<%= borda_controller_name(question) %>',
           "data-voter-borda-min-choices-value" => '<%= question.min_choices.to_i if borda?(question) %>',
           "data-voter-borda-max-choices-value" => '<%= question.max_votable_options if borda?(question) %>',
           "data-voter-borda-scoring-scale-value" => '<%= question.scoring_scale if borda?(question) %>',
           "data-voter-borda-ordinals-value" => '<%= borda_ordinals_json(question) if borda?(question) %>',
           "data-voter-borda-label-one-value" => '<%= borda_label_one_template if borda?(question) %>',
           "data-voter-borda-label-other-value" => '<%= borda_label_other_template if borda?(question) %>'
