<% if options.any? %>
  <div class="card questionnaire-question-ungrouped-options mx-4 my-8">
    <div class="card-divider">
      <h2 class="card-title"><%= title %></h2>
    </div>
    <div class="card-section">
      <p class="help-text"><%= hint %></p>
      <div class="group-response-options-list">
        <% options.each do |response_option| %>
          <%= fields_for "questions[#{question.to_param}][response_options][]", response_option do |response_option_form| %>
            <%= render "decidim/extra_censuses/elections/admin/questions/response_option_in_group",
                       form: response_option_form,
                       question: question,
                       group_id: response_option.group_id,
                       editable: editable %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
